<idea-plugin>
  <id>io.github.myangprint.motionflow</id>
  <name>MotionFlow</name>
  <vendor url="https://github.com/Myang-print">Haoran</vendor>

  <description><![CDATA[
    <p>Native, configurable visual motion for IntelliJ Platform IDEs.</p>
    <p>Follow caret movement, clicks, navigation jumps, editor changes, and tool-window focus through restrained, input-transparent cues.</p>
    <p>Includes motion profiles, Reduced Motion, Power Save behavior, local diagnostics, and no telemetry.</p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <resource-bundle>messages.MotionFlowBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="io.github.myangprint.motionflow.startup.MotionFlowStartupActivity"/>
    <applicationConfigurable
        id="io.github.myangprint.motionflow.settings"
        parentId="appearance"
        instance="io.github.myangprint.motionflow.settings.MotionFlowConfigurable"
        displayName="MotionFlow"/>
    <notificationGroup id="MotionFlow" displayType="BALLOON" isLogByDefault="false"/>
  </extensions>

  <actions>
    <action id="MotionFlow.ToggleMotion" class="io.github.myangprint.motionflow.actions.ToggleMotionAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="MotionFlow.OpenSettings" class="io.github.myangprint.motionflow.actions.OpenSettingsAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="MotionFlow.CopyDiagnostics" class="io.github.myangprint.motionflow.actions.CopyDiagnosticsAction"/>
  </actions>
</idea-plugin>
